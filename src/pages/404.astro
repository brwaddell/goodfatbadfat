---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Page not found — GoodFat"
  description="That page is missing. Head home, browse the blog, or contact GoodFat support."
  noindex
>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-2xl px-5 pb-24 pt-28 text-center sm:px-8 sm:text-left">
    <p class="label-micro text-yellow">404</p>
    <h1 class="mt-3 font-display text-4xl font-800 tracking-tight text-text sm:text-5xl">
      This page took a wrong turn.
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      The link may be outdated, or the page never existed. You can go back to the homepage, read the
      blog, or send us a note.
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-pill bg-yellow px-6 py-3 font-display text-sm font-700 text-ink transition-transform hover:-translate-y-0.5"
      >
        Back to home
      </a>
      <a
        href="/support"
        class="inline-flex items-center justify-center rounded-pill border border-border bg-card px-6 py-3 font-display text-sm font-700 text-text transition-colors hover:border-yellow/50"
      >
        Contact support
      </a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
