---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — GoodFat`} description={post.data.description}>
  <SiteHeader />
  <main id="main-content" class="mx-auto max-w-2xl px-5 pb-24 pt-28 sm:px-8">
    <p class="label-micro text-yellow">
      <a href="/blog" class="transition-colors hover:text-text">Blog</a>
      <span class="mx-2 text-border">/</span>
      {
        post.data.pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
    </p>
    <h1 class="mt-4 font-display text-4xl font-800 tracking-tight text-text text-balance sm:text-5xl">
      {post.data.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{post.data.description}</p>
    <article
      class="prose-goodfat mt-10 space-y-4 text-[16px] leading-relaxed text-muted [&_a]:text-yellow [&_strong]:text-text [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-800 [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_ul]:space-y-2"
    >
      <Content />
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
