---
---

<section id="ask" class="relative border-t border-border/60 py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_0.9fr] lg:gap-16">
      <div>
        <p class="label-micro text-yellow">Ask on your iPhone</p>
        <h2
          class="mt-4 max-w-[16ch] font-display text-3xl font-800 tracking-[-0.03em] text-text text-balance sm:text-5xl"
        >
          Stuck on dinner? Ask for a kinder plate.
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">
          Tell GoodFat what you ate. Apple Intelligence stays on the iPhone and looks up the food
          catalog there. If a meal is hard on your body, ask for a swap you will still enjoy.
        </p>
      </div>

      <div class="flex justify-center lg:justify-end">
        <picture>
          <source type="image/webp" srcset="/images/screens/ask.webp" />
          <img
            src="/images/screens/ask.png"
            alt="Logging a meal by chat in GoodFat"
            width="720"
            height="1465"
            class="w-[min(100%,280px)] drop-shadow-[0_32px_56px_rgba(0,0,0,0.5)]"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
