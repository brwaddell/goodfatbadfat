---
/**
 * Landing VitalitySphere — same color math + blob/particle look as the app.
 * Score sits above the period label (Weekly / Monthly / Today).
 */
type Props = {
  score?: number;
  label?: string;
  size?: number;
};

const { score = 28, label = "Weekly", size = 320 } = Astro.props;
const uid = `vs-${score}-${size}-${label}`.replace(/\s+/g, "-");
---

<div
  class="relative mx-auto flex items-center justify-center"
  style={`width:min(100%,${size}px);aspect-ratio:1`}
  data-vitality-sphere
  data-score={score}
  data-label={label}
  aria-label={`${label} inflammatory score ${score}`}
>
  <canvas class="h-full w-full" data-vs-canvas aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
    <span
      class="font-display text-[clamp(2.75rem,12vw,4.5rem)] font-800 leading-none tracking-[-0.04em] text-white"
      data-vs-score
      style="text-shadow:0 10px 36px rgba(34,163,95,0.45)"
    >
      {score}
    </span>
    <span class="label-micro mt-2 text-white/75" data-vs-label>{label}</span>
  </div>
</div>

<script>
  const GREEN = { r: 0x22, g: 0xa3, b: 0x5f };
  const AMBER = { r: 0xf2, g: 0xb0, b: 0x10 };
  const RED = { r: 0xe6, g: 0x19, b: 0x19 };

  function clamp(v, min, max) {
    return Math.min(max, Math.max(min, v));
  }
  function lerp(a, b, t) {
    return a + (b - a) * t;
  }
  function lerpRgb(a, b, t) {
    const u = clamp(t, 0, 1);
    return {
      r: Math.round(lerp(a.r, b.r, u)),
      g: Math.round(lerp(a.g, b.g, u)),
      b: Math.round(lerp(a.b, b.b, u)),
    };
  }
  function scoreToRgb(score) {
    const s = clamp(score, 0, 100);
    if (s <= 40) return GREEN;
    if (s >= 80) return RED;
    if (s <= 60) return lerpRgb(GREEN, AMBER, (s - 40) / 20);
    return lerpRgb(AMBER, RED, (s - 60) / 20);
  }
  function mulberry32(seed) {
    let a = seed >>> 0;
    return () => {
      a += 0x6d2b79f5;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function makeParticles(seed) {
    const rand = mulberry32(seed);
    return Array.from({ length: 12 }, () => {
      const x = rand();
      return {
        baseAngle: rand() * Math.PI * 2,
        baseRadius: (1 - (1 - x) * (1 - x)) * 0.95,
        angularSpeed: (rand() * 2 - 1) * 0.25,
        driftSpeed: 0.65 + rand() * 0.9,
        sizeFactor: rand(),
        phase: rand() * Math.PI * 2,
      };
    });
  }
  function buildBlobPath(ctx, cx, cy, radius, t, wobble) {
    const points = 72;
    const p1 = t * 0.85 + wobble * 3.2;
    const p2 = t * 1.15 - wobble * 2.4;
    const p3 = t * 0.6 + 1.7;
    ctx.beginPath();
    for (let i = 0; i <= points; i += 1) {
      const a = (i / points) * Math.PI * 2;
      const n =
        1 +
        0.075 * Math.sin(a * 3 + p1) +
        0.052 * Math.sin(a * 5 - p2) +
        0.035 * Math.sin(a * 8 + p3) +
        0.02 * Math.sin(a * 13 + p2 * 0.6);
      const r = radius * n;
      const x = cx + Math.cos(a) * r;
      const y = cy + Math.sin(a) * r;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.closePath();
  }

  function mountSphere(root) {
    const canvas = root.querySelector("[data-vs-canvas]");
    const scoreEl = root.querySelector("[data-vs-score]");
    if (!(canvas instanceof HTMLCanvasElement)) return;

    const score = Number(root.dataset.score || "28");
    const particles = makeParticles(Math.round(score * 100) + 17);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let start = performance.now();

    function draw(time) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const css = canvas.clientWidth || 320;
      const size = Math.max(1, Math.floor(css * dpr));
      if (canvas.width !== size || canvas.height !== size) {
        canvas.width = size;
        canvas.height = size;
      }

      ctx.clearRect(0, 0, size, size);
      const cx = size / 2;
      const cy = size / 2;
      const radius = size * 0.46;
      const accent = scoreToRgb(score);
      const highlight = lerpRgb({ r: 255, g: 255, b: 255 }, accent, 0.25);
      const breath = reduced ? 1 : 1 + 0.018 * Math.sin(time * 2);
      const wobble = reduced
        ? 0
        : 0.06 * Math.sin(time * 1.35) + 0.04 * Math.sin(time * 0.82 + 1.3);
      const pulse = reduced ? 1 : 1 + 0.03 * Math.sin(time * 2.15 + 0.4);
      const blobRadius = radius * 0.72 * pulse;

      if (scoreEl instanceof HTMLElement) {
        scoreEl.style.textShadow = `0 10px 36px rgba(${accent.r},${accent.g},${accent.b},0.5)`;
      }

      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(breath, breath);
      ctx.translate(-cx, -cy);

      const glow = ctx.createRadialGradient(cx, cy, radius * 0.2, cx, cy, radius * 1.28);
      glow.addColorStop(0, `rgba(${accent.r},${accent.g},${accent.b},0.4)`);
      glow.addColorStop(1, `rgba(${accent.r},${accent.g},${accent.b},0)`);
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(cx, cy, radius * 1.28, 0, Math.PI * 2);
      ctx.fill();

      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.clip();

      ctx.fillStyle = `rgba(${accent.r},${accent.g},${accent.b},0.22)`;
      buildBlobPath(ctx, cx, cy + radius * 0.02, blobRadius * 1.03, time + 0.25, wobble * 0.8);
      ctx.fill();

      const blobGrad = ctx.createRadialGradient(
        cx - radius * 0.12,
        cy - radius * 0.14,
        radius * 0.05,
        cx,
        cy,
        blobRadius * 1.15,
      );
      blobGrad.addColorStop(0, `rgba(${highlight.r},${highlight.g},${highlight.b},0.92)`);
      blobGrad.addColorStop(0.55, `rgba(${accent.r},${accent.g},${accent.b},0.95)`);
      blobGrad.addColorStop(1, `rgba(${accent.r},${accent.g},${accent.b},0.55)`);
      ctx.fillStyle = blobGrad;
      buildBlobPath(ctx, cx, cy, blobRadius, time, wobble);
      ctx.fill();

      const sheen = ctx.createLinearGradient(
        cx - radius * 0.5,
        cy - radius * 0.5,
        cx + radius * 0.5,
        cy + radius * 0.5,
      );
      sheen.addColorStop(0, "rgba(255,255,255,0.12)");
      sheen.addColorStop(1, "rgba(255,255,255,0)");
      ctx.fillStyle = sheen;
      buildBlobPath(ctx, cx, cy, blobRadius, time, wobble);
      ctx.fill();

      for (const p of particles) {
        const angle = p.baseAngle + time * p.angularSpeed;
        const r = radius * 0.8 * p.baseRadius;
        const drift = Math.sin(time * p.driftSpeed + p.phase) * (radius * 0.06);
        const x = cx + Math.cos(angle) * r;
        const y = cy + Math.sin(angle) * r + drift;
        const breathP = 0.55 + 0.45 * Math.sin(time * 1.7 + p.phase);
        const opacity = clamp(0.1 + 0.24 * breathP, 0, 0.38);
        const pr = clamp(radius * (0.01 + p.sizeFactor * 0.018), 1.4 * dpr, 5.4 * dpr);
        ctx.beginPath();
        ctx.fillStyle = `rgba(${accent.r},${accent.g},${accent.b},${opacity})`;
        ctx.arc(x, y, pr, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.fillStyle = `rgba(255,255,255,${clamp(opacity * 0.55, 0, 0.22)})`;
        ctx.arc(x, y, pr * 0.45, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      const glass = ctx.createRadialGradient(
        cx - radius * 0.15,
        cy - radius * 0.22,
        0,
        cx,
        cy,
        radius,
      );
      glass.addColorStop(0, "rgba(255,255,255,0.12)");
      glass.addColorStop(0.55, "rgba(255,255,255,0.05)");
      glass.addColorStop(1, "rgba(255,255,255,0.02)");
      ctx.fillStyle = glass;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = "rgba(255,255,255,0.18)";
      ctx.lineWidth = radius * 0.02;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.stroke();

      const spec = ctx.createRadialGradient(
        cx - radius * 0.2,
        cy - radius * 0.25,
        0,
        cx - radius * 0.2,
        cy - radius * 0.25,
        radius * 0.35,
      );
      spec.addColorStop(0, "rgba(255,255,255,0.28)");
      spec.addColorStop(1, "rgba(255,255,255,0)");
      ctx.fillStyle = spec;
      ctx.beginPath();
      ctx.ellipse(
        cx - radius * 0.2,
        cy - radius * 0.25,
        radius * 0.325,
        radius * 0.21,
        0,
        0,
        Math.PI * 2,
      );
      ctx.fill();

      ctx.restore();
    }

    function frame(now) {
      const time = (now - start) / 1000;
      draw(time);
      if (!reduced) requestAnimationFrame(frame);
    }

    draw(0);
    if (!reduced) requestAnimationFrame(frame);
  }

  document.querySelectorAll("[data-vitality-sphere]").forEach(mountSphere);
</script>
