---
import { appStoreUrl } from "../lib/site";
---

<footer class="border-t border-border/60 pb-10 pt-12">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-5 sm:flex-row sm:items-end sm:justify-between sm:px-8"
  >
    <div>
      <a href="/" class="inline-flex items-center gap-2.5" aria-label="GoodFat home">
        <img
          src="/images/splash-64.webp"
          alt=""
          width="28"
          height="33"
          class="h-7 w-auto"
          decoding="async"
        />
        <span class="font-display text-lg font-800 text-text">GoodFat</span>
      </a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
        Eat fats that help you feel better — on your iPhone, with Apple Intelligence.
      </p>
    </div>
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      <a
        href={appStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="label-micro text-muted transition-colors hover:text-text"
      >
        Get the app
      </a>
      <a href="/blog" class="label-micro text-muted transition-colors hover:text-text">Blog</a>
      <a href="/support" class="label-micro text-muted transition-colors hover:text-text">Support</a>
      <a href="/privacy" class="label-micro text-muted transition-colors hover:text-text">Privacy</a>
      <a href="/terms" class="label-micro text-muted transition-colors hover:text-text">Terms</a>
      <a href="/#how" class="label-micro text-muted transition-colors hover:text-text">How it works</a>
    </div>
  </div>
  <div class="mx-auto mt-10 max-w-6xl px-5 sm:px-8">
    <p class="text-xs text-muted">
      © {new Date().getFullYear()} GoodFat. For personal nutrition awareness — not medical advice. The
      inflammatory score is educational and experimental.
    </p>
  </div>
</footer>
